# CeyPay backend (CeyPay-BE). Defaults to http://localhost:4000.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Privy (CeyFi sign-in). Same app as PRIVY_APP_ID on the backend.
NEXT_PUBLIC_PRIVY_APP_ID=
# Optional — a Privy app client ID (dashboard → App settings → Clients)
NEXT_PUBLIC_PRIVY_CLIENT_ID=
